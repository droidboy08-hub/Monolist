#pragma once

// Generated by cmake/apicredentials.cmake, into the build tree only. Do not
// edit, and never copy it into the source tree or commit it.
//
// This build's Last.fm API account, when it was given one: the key and shared
// secret come from MONOLIST_LASTFM_API_KEY and MONOLIST_LASTFM_SHARED_SECRET
// at build time. They belong to whoever builds the app (Last.fm issues a key
// to a person, and may limit or suspend it for everyone's traffic combined),
// which is why they are not in the repository for a fork to reuse. Both empty
// means this build has no key, and the app says so instead of offering a
// Connect button that cannot work.
//
// Only lastfm.cpp includes this, and nothing may print either value.

#define MONOLIST_LASTFM_API_KEY       "@MONOLIST_LASTFM_API_KEY_VALUE@"
#define MONOLIST_LASTFM_SHARED_SECRET "@MONOLIST_LASTFM_SHARED_SECRET_VALUE@"
