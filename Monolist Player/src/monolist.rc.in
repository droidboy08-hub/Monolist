// The app's icons, for Explorer, the taskbar and the window: Qt's Windows
// platform takes IDI_ICON1 from the executable as every window's icon, and
// Explorer numbers them in this order. The first is the default; the others
// are Settings > Appearance's choices, which the app's own shortcuts are
// pointed at by number (AppIcon), so the order is AppIcon's. Made by
// packaging/make-icon.ps1; configured into the build folder by
// CMakeLists.txt, with the icons' full paths filled in.
IDI_ICON1 ICON "@MONOLIST_ICON@"
IDI_ICON2 ICON "@MONOLIST_ICON_RED@"

// What Windows calls the app where it names it: the media flyout beside the
// volume, Task Manager, a file's Properties. Without it, "monolist.exe".
// The numbers are winver.h's, written out so that nothing is included.
1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Monolist"
            VALUE "ProductName", "Monolist"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "monolist"
            VALUE "OriginalFilename", "monolist.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
