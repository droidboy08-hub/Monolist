<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Monolist.app's Info.plist. CMake fills in the MACOSX_BUNDLE_* values from
    the target's properties in CMakeLists.txt, and MONOLIST_MACOS_MINIMUM from
    the variable there; under the Xcode generator some of them are Xcode's own
    build settings, which Xcode fills in.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>Monolist</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>LSMinimumSystemVersion</key>
    <string>${MONOLIST_MACOS_MINIMUM}</string>

    <!--
        Opus and Ogg files open in Monolist (InstanceGuard, playFiles): its
        own downloads, which are Opus in Ogg, and anyone else's. macOS 26
        types .opus, .ogg and .oga alike as the system's Ogg audio. The other
        sound files it saves (M4A, MP3) are left to the apps that have them.
        Alternate: offered in Open With, and the Finder's double-click stays
        with whichever app had it.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Ogg audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.xiph.ogg-audio</string>
            </array>
        </dict>
    </array>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!--
        The design is paper and ink and draws every colour itself. In Dark
        Mode the few things the system still draws — the title bar behind the
        traffic lights, text selection, native dialogs — would turn dark
        against it, so the app keeps the light appearance, as the Windows
        build does.
    -->
    <key>NSRequiresAquaSystemAppearance</key>
    <true/>
</dict>
</plist>
