diff --git a/src-copy/src/benchlog.h b/src-copy/src/benchlog.h
new file mode 100644
index 0000000..0275608
--- /dev/null
+++ b/src-copy/src/benchlog.h
@@ -0,0 +1,38 @@
+#pragma once
+
+// BENCH INSTRUMENTATION (Step 2 measurement copy only, never in the repo).
+// benchMark() logs a line through qInfo (Qt clock, QT_MESSAGE_PATTERN) and,
+// once main() has hooked the engine in, also through mpv's print-text, so the
+// same line lands in mpv's own log-file stamped on mpv's clock. That lets the
+// two timelines be aligned to the millisecond.
+
+#include <QByteArray>
+#include <QElapsedTimer>
+#include <QString>
+#include <QtGlobal>
+
+#include <functional>
+
+inline std::function<void(const QByteArray &)> &benchMarker()
+{
+    static std::function<void(const QByteArray &)> marker;
+    return marker;
+}
+
+// Milliseconds since the process's first benchMark call site asked, on one
+// monotonic clock shared by every file.
+inline QElapsedTimer &benchClock()
+{
+    static QElapsedTimer clock;
+    if (!clock.isValid())
+        clock.start();
+    return clock;
+}
+
+inline void benchMark(const QString &text)
+{
+    const QByteArray bytes = text.toUtf8();
+    qInfo("bench: [%lld] %s", (long long)benchClock().elapsed(), bytes.constData());
+    if (benchMarker())
+        benchMarker()(bytes);
+}
