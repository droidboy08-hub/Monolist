+void MpvEngine::benchPrint(const QByteArray &text)
+{
+    if (!m_mpv)
+        return;
+    const QByteArray line = "BENCH " + text;
+    const char *args[] = { "print-text", line.constData(), nullptr };
+    mpv_command(m_mpv, args);
+}
+
+QString MpvEngine::benchCacheSample()
+{
+    if (!m_mpv)
+        return {};
+    int64_t speed = -1;
+    mpv_get_property(m_mpv, "cache-speed", MPV_FORMAT_INT64, &speed);
+    double timePos = -1;
+    mpv_get_property(m_mpv, "time-pos", MPV_FORMAT_DOUBLE, &timePos);
+    int pausedForCache = -1;
+    mpv_get_property(m_mpv, "paused-for-cache", MPV_FORMAT_FLAG, &pausedForCache);
+    double cacheDuration = -1;
+    mpv_get_property(m_mpv, "demuxer-cache-duration", MPV_FORMAT_DOUBLE, &cacheDuration);
+    int64_t fileSize = -1;
+    mpv_get_property(m_mpv, "file-size", MPV_FORMAT_INT64, &fileSize);
+    int64_t fwBytes = -1;
+    int64_t rawRate = -1;
+    int64_t totalBytes = -1;
+    int eof = -1;
+    mpv_node node;
+    if (mpv_get_property(m_mpv, "demuxer-cache-state", MPV_FORMAT_NODE, &node) >= 0) {
+        if (node.format == MPV_FORMAT_NODE_MAP && node.u.list) {
+            for (int i = 0; i < node.u.list->num; ++i) {
+                const char *key = node.u.list->keys[i];
+                const mpv_node &value = node.u.list->values[i];
+                if (qstrcmp(key, "fw-bytes") == 0 && value.format == MPV_FORMAT_INT64)
+                    fwBytes = value.u.int64;
+                else if (qstrcmp(key, "raw-input-rate") == 0 && value.format == MPV_FORMAT_INT64)
+                    rawRate = value.u.int64;
+                else if (qstrcmp(key, "total-bytes") == 0 && value.format == MPV_FORMAT_INT64)
+                    totalBytes = value.u.int64;
+                else if (qstrcmp(key, "eof") == 0 && value.format == MPV_FORMAT_FLAG)
+                    eof = value.u.flag;
+            }
+        }
+        mpv_free_node_contents(&node);
+    }
+    return QStringLiteral("pos=%1 pfc=%2 speed=%3 rawRate=%4 fwBytes=%5 totalBytes=%6 cacheDur=%7 eof=%8 fileSize=%9")
+        .arg(timePos, 0, 'f', 3).arg(pausedForCache).arg(qint64(speed)).arg(qint64(rawRate))
+        .arg(qint64(fwBytes)).arg(qint64(totalBytes)).arg(cacheDuration, 0, 'f', 1).arg(eof).arg(qint64(fileSize));
+}
