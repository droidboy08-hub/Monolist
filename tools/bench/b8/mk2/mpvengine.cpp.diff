+void MpvEngine::benchPrint(const QByteArray &text)
+{
+    if (!m_mpv)
+        return;
+    const QByteArray line = "BENCH " + text;
+    const char *args[] = { "print-text", line.constData(), nullptr };
+    mpv_command(m_mpv, args);
+}
